# runtime state
node_modules/
.venv/
.chrome-profile*/
__pycache__/
*.pyc
.DS_Store

# per-run output: everything here is regenerated by tools/make.sh.
# the ledger is the only thing worth keeping in git.
runs/*
!runs/ledger.json
!runs/.gitkeep

# generated media
*.mp4
*.mov
*.wav
*.m4a
*.mp3
*.png
*.jpg
*.jpeg
# ...except the sample run's QA sheet
!examples/**/*.png
!examples/**/*.jpg

logs/
